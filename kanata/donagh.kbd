#|
This text between the two pipe+octothorpe sequences is a multi-line comment.
Second line of text
|#

;; Text after double-semicolons are single-line comments.
;; =================================================================================

;; This file upgrades the left < key on my keyboard to a left alt 
;; easier to use in vanilla emacs being on the same rows and
;; handy for my application keyboard shortcuts like Alt B (Firefox) Alt Z (zim) etc.

;; =================================================================================
;; after making changes 
;; Arch%> sudo systemctl restart kanata.service 
;; and
;; Arch%> sudo /home/donagh/.cargo/bin/kanata -c /home/donagh/.config/kanata/donagh.kbd

;; aliases eson and esoff (see .zsh_aliases)

;; Notes
;; S-1 for !
;; S-` for ~ 
;; S-- for _ 

(defcfg
      process-unmapped-keys yes
      log-layer-changes no
)

(defsrc
  esc  e  t u  i    p
  caps s d g h j k l 
  <   v b   n  m
)

(defvar
      tap-time 200
      hold-time 200
)

(defalias
  capsesc (tap-hold $tap-time $hold-time caps lctrl)
  escctrl (tap-hold $tap-time $hold-time esc lctrl)
  altnew (tap-hold $tap-time $hold-time esc (layer-toggle donsie))
)


;; explanatory note
;; the idea in layers is to assign the key-event a label and then a '_' for any src key not used in that layer
;; so in the donsie layer; each of capsesc, escctrl, altnew are signified with '_' and then the key-events with the action you want to happen
;; NOTE: in each of the src, base layer and donsie layer there are the same number of items per row — and nearly always some '_' somewhere for "do nothing new when pressed"


(deflayer base
    @capsesc  _ _ _  _   _ 
    @escctrl _ _ _ _ _ _ _
    @altnew  _ _ _ _
)

;; in the following layer:
;; when I hold the '<' key (beside the 'z' key) then h j k l will perform left down up right outside of vim  — but just like vim
;; in emacs A-x is to access meta X / mini-buffer using '<' + m
;; in zim <-- basic vim motions in zim!
;; so now, for example, when '<' is pressed with either e, t u, i or p an 'unexpected' but 'designed' new action takes place
;; why these keys? because they either reduce pinkie strain in the main or provide vim keybindings application wide

(deflayer donsie
    _   =  `  S--   S-1    +
    _  C-6 del S-2 left down up right
    _  C-S-v bspc  S-` A-x
)

;; NOTES
;; what does C-6 do / mean? It toggles file/buffer if there are more than one open (I think)

  ;; Actions
  ;; esc  =  ` _  !  +
  ;; caps tf del @ L D U R 
  ;; <  psc bspc  ~  A-x

  ;; tf toggle file
  ;; psc paste system clipboard (much easier than Ctrl Shift V)

